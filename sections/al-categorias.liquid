{% comment %}
  Section contract.
  Accesos a colecciones en forma de teselas. Si la colección no tiene imagen propia,
  usa la foto de su primer producto.
{% endcomment %}

{%- render 'al-estilos' -%}

<div class="al-section al-categorias">
  <div class="al-wrap">
    <div class="al-section__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="al-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="al-h2">{{ section.settings.heading | escape }}</h2>
      </div>
    </div>

    <ul class="al-categorias__list" role="list">
      {%- assign usadas = '|' -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign coleccion = block.settings.collection
          if coleccion == blank
            continue
          endif
          assign imagen = coleccion.image
          if imagen == blank
            assign imagen = coleccion.products.first.featured_image
            for candidato in coleccion.products limit: 12
              assign marca = candidato.id | append: '|'
              unless usadas contains marca
                assign imagen = candidato.featured_image
                assign usadas = usadas | append: marca
                break
              endunless
            endfor
          endif
          assign titulo = block.settings.title | default: coleccion.title
        -%}
        <li class="al-categorias__item al-reveal" {{ block.shopify_attributes }}>
          <a class="al-categorias__link" href="{{ coleccion.url }}">
            {%- if imagen -%}
              {{
                imagen
                | image_url: width: 1100
                | image_tag:
                  class: 'al-categorias__img',
                  loading: 'lazy',
                  widths: '400, 600, 800, 1100',
                  sizes: '(min-width: 750px) 33vw, 100vw',
                  alt: ''
              }}
            {%- endif -%}
            <span class="al-categorias__shade"></span>
            <span class="al-categorias__label">
              <span class="al-categorias__title">{{ titulo | escape }}</span>
              <span class="al-categorias__count">
                {{- coleccion.products_count }} {% if coleccion.products_count == 1 %}producto{% else %}productos{% endif -%}
              </span>
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  .al-categorias__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(14px, 2vw, 24px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .al-categorias__link {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 0;
    background: #e4dac9;
    color: #fff;
    text-decoration: none;
  }

  .al-categorias__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease;
  }

  .al-categorias__link:hover .al-categorias__img {
    transform: scale(1.05);
  }

  .al-categorias__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgb(30 26 20 / 0.62) 0%, rgb(30 26 20 / 0) 55%);
  }

  .al-categorias__label {
    position: absolute;
    right: 22px;
    bottom: 20px;
    left: 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .al-categorias__title {
    font-family: var(--font-heading--family);
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    line-height: 1;
  }

  .al-categorias__count {
    font-family: var(--font-subheading--family);
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.92;
  }

  .al-categorias__count::after {
    content: ' \2192';
  }

  @media (max-width: 749px) {
    .al-categorias__list {
      grid-template-columns: minmax(0, 1fr);
    }

    .al-categorias__link {
      aspect-ratio: 16 / 10;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .al-categorias__img {
      transition: none;
    }

    .al-categorias__link:hover .al-categorias__img {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "AL · Categorías",
  "tag": "section",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Compra por categoría" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Encuentra lo tuyo" }
  ],
  "blocks": [
    {
      "type": "categoria",
      "name": "Categoría",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Colección" },
        { "type": "text", "id": "title", "label": "Título (opcional)" }
      ]
    }
  ],
  "presets": [{ "name": "AL · Categorías", "blocks": [{ "type": "categoria" }, { "type": "categoria" }, { "type": "categoria" }] }]
}
{% endschema %}
