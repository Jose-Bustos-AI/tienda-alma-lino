{% comment %}
  Section contract.
  Rejilla de productos de una colección con foto, precio y botón de añadir al carrito.
  El formulario es un envío normal a /cart/add, así que funciona sin JavaScript.
{% endcomment %}

{%- render 'al-estilos' -%}

{%- liquid
  assign coleccion = section.settings.collection
  assign limite = section.settings.limit
-%}

<div class="al-section al-destacados">
  <div class="al-wrap">
    <div class="al-section__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="al-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="al-h2">{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if coleccion != blank and section.settings.link_label != blank -%}
        <a class="al-link" href="{{ coleccion.url }}">{{ section.settings.link_label | escape }}</a>
      {%- endif -%}
    </div>

    {%- if coleccion != blank and coleccion.products_count > 0 -%}
      <ul class="al-grid" role="list">
        {%- for product in coleccion.products limit: limite -%}
          {%- assign variante = product.selected_or_first_available_variant -%}
          <li class="al-card">
            <a class="al-card__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
              {%- if product.featured_image -%}
                {{
                  product.featured_image
                  | image_url: width: 900
                  | image_tag:
                    class: 'al-card__img',
                    loading: 'lazy',
                    widths: '300, 450, 600, 900',
                    sizes: '(min-width: 990px) 25vw, 50vw',
                    alt: product.featured_image.alt
                  | default: product.title
                }}
              {%- endif -%}
              {%- if product.compare_at_price > product.price -%}
                <span class="al-card__badge">Oferta</span>
              {%- endif -%}
            </a>
            <div class="al-card__body">
              <p class="al-card__type">{{ product.type | escape }}</p>
              <h3 class="al-card__title">
                <a href="{{ product.url }}">{{ product.title | escape }}</a>
              </h3>
              <p class="al-card__price">
                <span>{{ product.price | money }}</span>
                {%- if product.compare_at_price > product.price -%}
                  <s>{{ product.compare_at_price | money }}</s>
                {%- endif -%}
              </p>
              {%- if product.has_only_default_variant == false and product.available -%}
                <a class="al-card__btn al-card__btn--link" href="{{ product.url }}">Elegir talla</a>
              {%- elsif variante.available -%}
                <form method="post" action="{{ routes.cart_add_url }}" class="al-card__form">
                  <input type="hidden" name="id" value="{{ variante.id }}">
                  <input type="hidden" name="quantity" value="1">
                  <button type="submit" class="al-card__btn">Añadir al carrito</button>
                </form>
              {%- else -%}
                <p class="al-card__soldout">Agotado</p>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="al-lead">Elige una colección con productos en los ajustes de esta sección.</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .al-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(16px, 2.4vw, 32px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .al-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .al-card__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 0;
    background: #ebe3d5;
  }

  .al-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .al-card__media:hover .al-card__img {
    transform: scale(1.045);
  }

  .al-card__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 5px 12px;
    border-radius: 2px;
    background: #2c4a66;
    color: #fff;
    font-family: var(--font-subheading--family);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .al-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding-top: 16px;
  }

  .al-card__type {
    margin: 0 0 4px;
    font-family: var(--font-subheading--family);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #8a7f70;
  }

  .al-card__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: 500;
    font-size: 1.32rem;
    line-height: 1.18;
  }

  .al-card__title a {
    color: #23211d;
    text-decoration: none;
  }

  .al-card__title a:hover {
    color: #2c4a66;
  }

  .al-card__price {
    display: flex;
    gap: 10px;
    align-items: baseline;
    margin: 8px 0 14px;
    font-family: var(--font-subheading--family);
    font-size: 1rem;
    color: #23211d;
  }

  .al-card__price s {
    font-size: 0.88rem;
    color: #9a9082;
  }

  .al-card__form {
    margin-top: auto;
  }

  .al-card__btn {
    width: 100%;
    min-height: 44px;
    border: 1px solid #23211d;
    border-radius: 2px;
    background: transparent;
    color: #23211d;
    font-family: var(--font-subheading--family);
    font-size: 0.86rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    cursor: pointer;
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  .al-card__btn--link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  }

  .al-card__btn:hover {
    background: #23211d;
    color: #f6f1e8;
  }

  .al-card__soldout {
    margin: auto 0 0;
    font-size: 0.86rem;
    color: #8a7f70;
  }

  @media (max-width: 989px) {
    .al-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .al-card__title {
      font-size: 1.14rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .al-card__img,
    .al-card__btn {
      transition: none;
    }

    .al-card__media:hover .al-card__img {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "AL · Productos destacados",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Los favoritos" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Más vendidos" },
    { "type": "collection", "id": "collection", "label": "Colección" },
    { "type": "range", "id": "limit", "label": "Número de productos", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "text", "id": "link_label", "label": "Texto del enlace", "default": "Ver todos" }
  ],
  "presets": [{ "name": "AL · Productos destacados" }]
}
{% endschema %}
