{% comment %}
  Section contract.
  Look en piezas: cada bloque enlaza una prenda y explica cómo llevarla.
{% endcomment %}

{%- render 'al-estilos' -%}

<div class="al-section al-ritual">
  <div class="al-wrap">
    <div class="al-ritual__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="al-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="al-h2">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="al-lead">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    <ol class="al-ritual__list" role="list">
      {%- for block in section.blocks -%}
        {%- assign producto = block.settings.product -%}
        <li class="al-ritual__step al-reveal" {{ block.shopify_attributes }}>
          <div class="al-ritual__media">
            {%- if producto != blank and producto.featured_image -%}
              {{
                producto.featured_image
                | image_url: width: 900
                | image_tag:
                  class: 'al-ritual__img',
                  loading: 'lazy',
                  widths: '300, 450, 600, 900',
                  sizes: '(min-width: 750px) 33vw, 100vw',
                  alt: producto.title
              }}
            {%- endif -%}
            <span class="al-ritual__num">{{ section.settings.step_label | escape }} {{ forloop.index }}</span>
          </div>
          <h3 class="al-ritual__title">{{ block.settings.title | escape }}</h3>
          <p class="al-ritual__text">{{ block.settings.text | escape }}</p>
          {%- if producto != blank -%}
            <a class="al-link" href="{{ producto.url }}">{{ producto.title | escape }} · {{ producto.price | money }}</a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</div>

{% stylesheet %}
  .al-ritual {
    background: #efe8dc;
  }

  .al-ritual__head {
    max-width: 720px;
    margin-bottom: clamp(28px, 4vw, 52px);
  }

  .al-ritual__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 40px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .al-ritual__step {
    min-width: 0;
  }

  .al-ritual__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 0;
    background: #e4dac9;
  }

  .al-ritual__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease;
  }

  .al-ritual__step:hover .al-ritual__img {
    transform: scale(1.04);
  }

  @media (prefers-reduced-motion: reduce) {
    .al-ritual__img {
      transition: none;
    }

    .al-ritual__step:hover .al-ritual__img {
      transform: none;
    }
  }

  .al-ritual__num {
    position: absolute;
    top: 16px;
    left: 16px;
    padding: 6px 14px;
    border-radius: 2px;
    background: rgb(246 241 232 / 0.92);
    font-family: var(--font-subheading--family);
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #23211d;
  }

  .al-ritual__title {
    margin: 20px 0 6px;
    font-family: var(--font-heading--family);
    font-weight: 500;
    font-size: 1.7rem;
    line-height: 1.1;
    color: #23211d;
  }

  .al-ritual__text {
    margin: 0 0 12px;
    font-size: 0.98rem;
    line-height: 1.6;
    color: #5a554c;
  }

  @media (max-width: 749px) {
    .al-ritual__list {
      grid-template-columns: minmax(0, 1fr);
    }

    .al-ritual__media {
      aspect-ratio: 4 / 3;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "AL · Look en piezas",
  "tag": "section",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Cómo combinarlo" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Un look, tres piezas" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Tres prendas que combinan entre sí." },
    { "type": "text", "id": "step_label", "label": "Etiqueta de cada paso", "default": "Pieza" }
  ],
  "blocks": [
    {
      "type": "paso",
      "name": "Pieza",
      "settings": [
        { "type": "product", "id": "product", "label": "Producto" },
        { "type": "text", "id": "title", "label": "Título", "default": "La camisa" },
        { "type": "textarea", "id": "text", "label": "Texto", "default": "Explica aquí cómo llevarla." }
      ]
    }
  ],
  "presets": [{ "name": "AL · Look en piezas", "blocks": [{ "type": "paso" }, { "type": "paso" }, { "type": "paso" }] }]
}
{% endschema %}
